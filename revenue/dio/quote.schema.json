{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://woahwhattheheck.github.io/commons/revenue/dio/quote.schema.json",
  "title": "DIO quote and accepted-work transition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "quote_id",
    "job_id",
    "status",
    "quoted_at",
    "valid_until",
    "provider_reference",
    "scope",
    "price",
    "accepted_work",
    "result_address",
    "substrate",
    "bazaar",
    "payment"
  ],
  "properties": {
    "schema_version": {
      "const": "dio-revenue/v1"
    },
    "kind": {
      "const": "QUOTE"
    },
    "quote_id": {
      "$ref": "customer_job.schema.json#/$defs/id"
    },
    "job_id": {
      "$ref": "customer_job.schema.json#/$defs/id"
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "OFFERED",
        "ACCEPTED",
        "DECLINED",
        "EXPIRED",
        "WITHDRAWN"
      ]
    },
    "quoted_at": {
      "$ref": "customer_job.schema.json#/$defs/timestamp"
    },
    "valid_until": {
      "anyOf": [
        {
          "$ref": "customer_job.schema.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "provider_reference": {
      "type": "string",
      "minLength": 1,
      "description": "Routing/correlation metadata only."
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "price": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount_decimal",
        "currency",
        "basis"
      ],
      "properties": {
        "amount_decimal": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,8})?$"
        },
        "currency": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z][A-Z0-9._-]{1,31}$"
        },
        "basis": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "accepted_work": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "accepted_at",
            "acceptance_reference"
          ],
          "properties": {
            "accepted_at": {
              "$ref": "customer_job.schema.json#/$defs/timestamp"
            },
            "acceptance_reference": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "result_address": {
      "type": "string",
      "minLength": 1
    },
    "substrate": {
      "$ref": "customer_job.schema.json#/$defs/substrate"
    },
    "bazaar": {
      "$ref": "customer_job.schema.json#/$defs/bazaarLink"
    },
    "payment": {
      "$ref": "customer_job.schema.json#/$defs/payment"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ACCEPTED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "accepted_work": {
            "type": "object"
          },
          "price": {
            "properties": {
              "amount_decimal": {
                "type": "string"
              },
              "currency": {
                "type": "string"
              }
            }
          },
          "bazaar": {
            "properties": {
              "action_id": {
                "$ref": "customer_job.schema.json#/$defs/id"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "accepted_work": {
            "type": "null"
          }
        }
      }
    }
  ]
}
