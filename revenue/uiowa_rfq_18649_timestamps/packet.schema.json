{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UIOWA-129 timestamp packet, schema 1",
  "type": "object",
  "required": [
    "schema_version",
    "events"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "synthetic": {
      "type": "boolean"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "timestamp": {
            "$ref": "#/$defs/timestamp"
          }
        },
        "additionalProperties": true
      }
    },
    "intervals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "start",
          "end"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "start": {
            "type": "string",
            "minLength": 1
          },
          "end": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "timestamp": {
      "oneOf": [
        {
          "type": [
            "string",
            "null"
          ]
        },
        {
          "type": "object",
          "required": [
            "value"
          ],
          "properties": {
            "value": {
              "type": [
                "string",
                "null"
              ]
            },
            "zone": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "fold": {
              "type": [
                "integer",
                "null"
              ],
              "enum": [
                0,
                1,
                null
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "$comment": "Lexical timestamp validation, nonblank IDs, ID uniqueness, timezone/fold/offset consistency and interval resolution are enforced by timestamp_adapter.py. This schema does not certify time validity or evidence authenticity."
}
