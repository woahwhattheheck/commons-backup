_identity":"in-fssa-27-88284-package-20261003","source_ref":"https://secure.in.gov/idoa/proc/solicitations/files/004980000088284.zip","source_sha256":"0bc2c4a47aa2cba6b5732b9308c6d581befd9df957dc03c22796349b5279b867"},{"attachment_id":"attestation","ref":"raw/official-package.zip!/Att J - Attestation Form.docx","sha256":"2de6cf5b6fd4502dce0515b8f9de15967dfc78f2fe3c38715edcebc5021dc862","source_id":"fssa-official-package-20261003","source_identity":"in-fssa-27-88284-package-20261003","source_ref":"https://secure.in.gov/idoa/proc/solicitations/files/004980000088284.zip","source_sha256":"0bc2c4a47aa2cba6b5732b9308c6d581befd9df957dc03c22796349b5279b867"},{"attachment_id":"scope-of-work","ref":"raw/official-package.zip!/Att K - SoW.docx","sha256":"eb2f2877063cc3078d572ac32765b3db81d0a56744e1018fbd5d1c70dad92819","source_id":"fssa-official-package-20261003","source_identity":"in-fssa-27-88284-package-20261003","source_ref":"https://secure.in.gov/idoa/proc/solicitations/files/004980000088284.zip","source_sha256":"0bc2c4a47aa2cba6b5732b9308c6d581befd9df957dc03c22796349b5279b867"},{"attachment_id":"ai-questions","ref":"raw/official-package.zip!/Att L - AI - Technical Proposal Questions.docx","sha256":"f6ce26309ddd37a3ed959a7929a093a2937bc6a02cb21e703c1f8159ccffb69d","source_id":"fssa-official-package-20261003","source_identity":"in-fssa-27-88284-package-20261003","source_ref":"https://secure.in.gov/idoa/proc/solicitations/files/004980000088284.zip","source_sha256":"0bc2c4a47aa2cba6b5732b9308c6d581befd9df957dc03c22796349b5279b867"},{"attachment_id":"infrastructure-overview","ref":"raw/official-package.zip!/Att M - Infrastructure Overview.docx","sha256":"488fc4fe205b19a2df80555486b8e2583445e06b895ed9e9055652400d08575a","source_id":"fssa-official-package-20261003","source_identity":"in-fssa-27-88284-package-20261003","source_ref":"https://secure.in.gov/idoa/proc/solicitations/files/004980000088284.zip","source_sha256":"0bc2c4a47aa2cba6b5732b9308c6d581befd9df957dc03c22796349b5279b867"}],"authority":{"award_or_revenue_recognized":false,"buyer_contact_authorized":false,"certification_authorized":false,"payment_authorized":false,"portal_action_authorized":false,"price_commitment_authorized":false,"prime_contact_authorized":false,"proposal_authorized":false,"signature_authorized":false,"submission_authorized":false},"current_source":{"captured_at":"2026-10-03T22:10:55Z","identity":"in-fssa-27-88284-package-20261003","ref":"https://secure.in.gov/idoa/proc/solicitations/files/004980000088284.zip","sequence":1,"sha256":"0bc2c4a47aa2cba6b5732b9308c6d581befd9df957dc03c22796349b5279b867","source_id":"fssa-official-package-20261003"},"deadline":{"identity":"in-fssa-27-88284-package-20261003","ref":"https://secure.in.gov/idoa/proc/solicitations/files/004980000088284.zip","sha256":"0bc2c4a47aa2cba6b5732b9308c6d581befd9df957dc03c22796349b5279b867","source_id":"fssa-official-package-20261003","utc":"2026-10-28T19:00:00Z","value":"2026-10-28T15:00:00-04:00"},"evaluated_at":"2026-10-03T22:34:36Z","killed_sources":[],"pack_id":"in-fssa-nwd-mac-27-88284-20261003","requirements":[{"family":"subcontractor_partner_matrix","kind":"MANDATORY","lineage_id":"FSSA-001-responsible-prime","section_id":"RFP.1.2.Respondent.p5","sequence":1,"source_captured_at":"2026-10-03T22:10:55Z","source_id":"fssa-official-package-20261003","source_identity":"in-fssa-27-88284-package-20261003","source_ref":"https://secure.in.gov/idoa/proc/solicitations/files/004980000088284.zip","source_sha256":"0bc2c4a47aa2cba6b5732b9308c6d581befd9df957dc03c22796349b5279b867","tags":["indiana-fssa","medicaid-administrative-claiming"],"text":"Identify one entity responsible for contract performance. Joint or combined proposals from two or more offerors are not responsive."},{"family":"compliance_crosswalk","kind":"MANDATORY","lineage_id":"FSSA-002-portal-submission","section_id":"RFP.1.7-1.16.p8-11","sequence":1,"source_captured_at":"2026-10-03T22:10:55Z","source_id":"fssa-official-package-20261003","source_identity":"in-fssa-27-88284-package-20261003","source_ref":"https://secure.in.gov/idoa/proc/solicitations/files/004980000088284.zip","source_sha256":"0bc2c4a47aa2cba6b5732b9308c6d581befd9df957dc03c22796349b5279b867","tags":["indiana-fssa","medicaid-administrative-claiming"],"text":"Use the Supplier Portal with a registered Bidder ID and finish submission by the stated deadline; other submission methods and late uploads are not accepted."},{"family":"compliance_crosswalk","kind":"MANDATORY","lineage_id":"FSSA-003-response-format","section_id":"RFP.2.1.p14","sequence":1,"source_captured_at":"2026-10-03T22:10:55Z","source_id":"fssa-official-package-20261003","source_identity":"in-fssa-27-88284-package-20261003","source_ref":"https://secure.in.gov/idoa/proc/solicitations/files/004980000088284.zip","source_sha256":"0bc2c4a47aa2cba6b5732b9308c6d581befd9df957dc03c22796349b5279b867","tags":["indiana-fssa","medicaid-administrative-claiming"],"text":"Address every item; submit the executive-summary letter, each response item and attachments as separate standalone files, preserving the original attachment formats."},{"family":"compliance_crosswalk","kind":"MANDATORY","lineage_id":"FSSA-004-required-ai-infrastructure","section_id":"RFP.3.2.Step1.p18","sequence":1,"source_captured_at":"2026-10-03T22:10:55Z","source_id":"fssa-official-package-20261003","source_identity":"in-fssa-27-88284-package-20261003","source_ref":"https://secure.in.gov/idoa/proc/solicitations/files/004980000088284.zip","source_sha256":"0bc2c4a47aa2cba6b5732b9308c6d581befd9df957dc03c22796349b5279b867","tags":["indiana-fssa","medicaid-administrative-claiming"],"text":"Return both the Artificial Intelligence Technical Proposal Questions and Infrastructure Overview, together with the executive summary and Attachments D, E, F and J."},{"family":"corporate_capability","kind":"MANDATORY","lineage_id":"FSSA-005-signature-authority","section_id":"AttJ.6.0","sequence":1,"source_captured_at":"2026-10-03T22:10:55Z","source_id":"fssa-official-package-20261003","source_identity":"in-fssa-27-88284-package-20261003","source_ref":"https://secure.in.gov/idoa/proc/solicitations/files/004980000088284.zip","source_sha256":"0bc2c4a47aa2cba6b5732b9308c6d581befd9df957dc03c22796349b5279b867","tags":["indiana-fssa","medicaid-administrative-claiming"],"text":"Provide evidence that the executive-summary signer can bind the respondent, such as bylaws or a board resolution, and the required organizational identifiers and response contact information."},{"family":"corporate_capability","kind":"MANDATORY","lineage_id":"FSSA-006-company-structure","section_id":"AttE.2.0","sequence":1,"source_captured_at":"2026-10-03T22:10:55Z","source_id":"fssa-official-package-20261003","source_identity":"in-fssa-27-88284-package-20261003","source_ref":"https://secure.in.gov/idoa/proc/solicitations/files/004980000088284.zip","source_sha256":"0bc2c4a47aa2cba6b5732b9308c6d581befd9df957dc03c22796349b5279b867","tags":["indiana-fssa","medicaid-administrative-claiming"],"text":"Describe the respondent's legal form, formation state, certificate of authority, business activities and organization chart, including the responsible product division where applicable."},{"family":"corporate_capability","kind":"MANDATORY","lineage_id":"FSSA-007-financial-stability","section_id":"AttE.3.0","sequence":1,"source_captured_at":"2026-10-03T22:10:55Z","source_id":"fssa-official-package-20261003","source_identity":"in-fssa-27-88284-package-20261003","source_ref":"https://secure.in.gov/idoa/proc/solicitations/files/004980000088284.zip","source_sha256":"0bc2c4a47aa2cba6b5732b9308c6d581befd9df957dc03c22796349b5279b867","tags":["indiana-fssa","medicaid-administrative-claiming"],"text":"Provide financial-stability documents: a recent D&B report is preferred, or two completed fiscal years of audited statements. If neither is available, explain why and provide income statements and balance sheets for those years. Parent-company evidence needs respondent-specific relationship and stability information."},{"family":"corporate_capability","kind":"MANDATORY","lineage_id":"FSSA-008-financial-responsibility-statement","section_id":"AttE.4.0","sequence":1,"source_captured_at":"2026-10-03T22:10:55Z","source_id":"fssa-official-package-20261003","source_identity":"in-fssa-27-88284-package-20261003","source_ref":"https://secure.in.gov/idoa/proc/solicitations/files/004980000088284.zip","source_sha256":"0bc2c4a47aa2cba6b5732b9308c6d581befd9df957dc03c22796349b5279b867","tags":["indiana-fssa","medicaid-administrative-claiming"],"text":"Include a statement that the responding entity's CEO and/or CFO takes responsibility for the completeness and correctness of the supplied financial information, with the requested governance information."},{"family":"corporate_capability","kind":"INFORMATIONAL","lineage_id":"FSSA-009-removed-e14","section_id":"AttE.14.0","sequence":1,"source_captured_at":"2026-10-03T22:10:55Z","source_id":"fssa-official-package-20261003","source_identity":"in-fssa-27-88284-package-20261003","source_ref":"https://secure.in.gov/idoa/proc/solicitations/files/004980000088284.zip","source_sha256":"0bc2c4a47aa2cba6b5732b9308c6d581befd9df957dc03c22796349b5279b867","tags":["indiana-fssa","medicaid-administrative-claiming"],"text":"Attachment E section 14, Evidence of Financial Responsibility, is expressly removed at the agency's request. This does not remove the separate financial-stability information requested by section 3."},{"family":"references_past_performance","kind":"SCORED","lineage_id":"FSSA-010-experience","section_id":"AttE.9.0-10.0","sequence":1,"source_captured_at":"2026-10-03T22:10:55Z","source_id":"fssa-official-package-20261003","source_identity":"in-fssa-27-88284-package-20261003","source_ref":"https://secure.in.gov/idoa/proc/solicitations/files/004980000088284.zip","source_sha256":"0bc2c4a47aa2cba6b5732b9308c6d581befd9df957dc03c22796349b5279b867","tags":["indiana-fssa","medicaid-administrative-claiming"],"text":"Describe government-service experience and provide named examples of clients with comparable size and scope; the Business and Technical Proposals form the management/quality evaluation."},{"family":"references_past_performance","kind":"MANDATORY","lineage_id":"FSSA-011-three-client-references","section_id":"AttE.6.0-and-AttH","sequence":1,"source_captured_at":"2026-10-03T22:10:55Z","source_id":"fssa-official-package-20261003","source_identity":"in-fssa-27-88284-package-20261003","source_ref":"https://secure.in.gov/idoa/proc/solicitations/files/004980000088284.zip","source_sha256":"0bc2c4a47aa2cba6b5732b9308c6d581befd9df957dc03c22796349b5279b867","tags":["indiana-fssa","medicaid-administrative-claiming"],"text":"Provide three Attachment H references from clients for whom the respondent provided the same or similar services. Clients complete and send their forms directly to the State; receipt is due October 28, 2026 at 3:00 PM Eastern Time."},{"family":"subcontractor_partner_matrix","kind":"MANDATORY","lineage_id":"FSSA-012-subcontractor-commitments","section_id":"AttE.13.0","sequence":1,"source_captured_at":"2026-10-03T22:10:55Z","source_id":"fssa-official-package-20261003","source_identity":"in-fssa-27-88284-package-20261003","source_ref":"https://secure.in.gov/idoa/proc/solicitations/files/004980000088284.zip","source_sha256":"0bc2c4a47aa2cba6b5732b9308c6d581befd9df957dc03c22796349b5279b867","tags":["indiana-fssa","medicaid-administrative-claiming"],"text":"If subcontractors are proposed, disclose every subcontractor, workshare, qualifications, contractual relationship and anticipated amount. Include an executed subcontract or signed letter of agreement; combined qualifications may be evaluated, while the respondent remains responsible."},{"family":"subcontractor_partner_matrix","kind":"INFORMATIONAL","lineage_id":"FSSA-013-voluntary-networking","section_id":"RFP.1.5.p7","sequence":1,"source_captured_at":"2026-10-03T22:10:55Z","source_id":"fssa-official-package-20261003","source_identity":"in-fssa-27-88284-package-20261003","source_ref":"https://secure.in.gov/idoa/proc/solicitations/files/004980000088284.zip","source_sha256":"0bc2c4a47aa2cba6b5732b9308c6d581befd9df957dc03c22796349b5279b867","tags":["indiana-fssa","medicaid-administrative-claiming"],"text":"Attachment I is an optional networking form. The State encourages it, but the RFP does not require its submission."},{"family":"subcontractor_partner_matrix","kind":"SCORED","lineage_id":"FSSA-014-ivosb-scoring","section_id":"RFP.1.20-1.21-and-3.2.5","sequence":1,"source_captured_at":"2026-10-03T22:10:55Z","source_id":"fssa-official-package-20261003","source_identity":"in-fssa-27-88284-package-20261003","source_ref":"https://secure.in.gov/idoa/proc/solicitations/files/004980000088284.zip","source_sha256":"0bc2c4a47aa2cba6b5732b9308c6d581befd9df957dc03c22796349b5279b867","tags":["indiana-fssa","medicaid-administrative-claiming"],"text":"The IVOSB goal is 3% and affects evaluation points. If participation is proposed, provide Attachment A and valid certification by the proposal due date; its bid total must match Attachment D. Zero participation deducts one point rather than creating a stated universal participation condition."},{"family":"corporate_capability","kind":"SCORED","lineage_id":"FSSA-015-buy-indiana-scoring","section_id":"AttJ.3.0","sequence":1,"source_captured_at":"2026-10-03T22:10:55Z","source_id":"fssa-official-package-20261003","source_identity":"in-fssa-27-88284-package-20261003","source_ref":"https://secure.in.gov/idoa/proc/solicitations/files/004980000088284.zip","source_sha256":"0bc2c4a47aa2cba6b5732b9308c6d581befd9df957dc03c22796349b5279b867","tags":["indiana-fssa","medicaid-administrative-claiming"],"text":"Buy Indiana points require an affirmative claim and finalized status at sourcing-event submission. The form permits a respondent to decline the claim."},{"family":"compliance_crosswalk","kind":"MANDATORY","lineage_id":"FSSA-016-contract-response","section_id":"AttE.5.0-and-12.0","sequence":1,"source_captured_at":"2026-10-03T22:10:55Z","source_id":"fssa-official-package-20261003","source_identity":"in-fssa-27-88284-package-20261003","source_ref":"https://secure.in.gov/idoa/proc/solicitations/files/004980000088284.zip","source_sha256":"0bc2c4a47aa2cba6b5732b9308c6d581befd9df957dc03c22796349b5279b867","tags":["indiana-fssa","medicaid-administrative-claiming"],"text":"Review the sample contract and any applicable IaaS, PaaS and SaaS terms. Submit any permitted proposed changes with the proposal as tracked redlines and explanations; later changes are not assured and the State may reject proposed language."},{"family":"corporate_capability","kind":"MANDATORY","lineage_id":"FSSA-017-sos-registration-timing","section_id":"RFP.1.17.p12","sequence":1,"source_captured_at":"2026-10-03T22:10:55Z","source_id":"fssa-official-package-20261003","source_identity":"in-fssa-27-88284-package-20261003","source_ref":"https://secure.in.gov/idoa/proc/solicitations/files/004980000088284.zip","source_sha256":"0bc2c4a47aa2cba6b5732b9308c6d581befd9df957dc03c22796349b5279b867","tags":["indiana-fssa","medicaid-administrative-claiming"],"text":"If awarded, the covered organization types must register and be in good standing with Indiana's Secretary of State. Report current status in Attachment J; the RFP places the registration obligation at award."},{"family":"corporate_capability","kind":"MANDATORY","lineage_id":"FSSA-018-prior-state-performance","section_id":"RFP.3.2.Step1.p18.performance","sequence":1,"source_captured_at":"2026-10-03T22:10:55Z","source_id":"fssa-official-package-20261003","source_identity":"in-fssa-27-88284-package-20261003","source_ref":"https://secure.in.gov/idoa/proc/solicitations/files/004980000088284.zip","source_sha256":"0bc2c4a47aa2cba6b5732b9308c6d581befd9df957dc03c22796349b5279b867","tags":["indiana-fssa","medicaid-administrative-claiming"],"text":"The respondent must not have had a State contract or purchase order terminated or cancelled in the last two calendar years for failure to deliver in accordance with its terms."},{"family":"compliance_crosswalk","kind":"MANDATORY","lineage_id":"FSSA-019-conflicts-and-certifications","section_id":"RFP.1.18-1.19.p12","sequence":1,"source_captured_at":"2026-10-03T22:10:55Z","source_id":"fssa-official-package-20261003","source_identity":"in-fssa-27-88284-package-20261003","source_ref":"https://secure.in.gov/idoa/proc/solicitations/files/004980000088284.zip","source_sha256":"0bc2c4a47aa2cba6b5732b9308c6d581befd9df957dc03c22796349b5279b867","tags":["indiana-fssa","medicaid-administrative-claiming"],"text":"Review the State-action, payment-arrears and conflict-of-interest representations before any response. Participation in preparing the solicitation, including the specified recent-hire circumstance, bars responding under the stated provision."},{"family":"accessibility","kind":"MANDATORY","lineage_id":"FSSA-020-it-and-accessibility","section_id":"RFP.1.3-and-1.22.p6-13","sequence":1,"source_captured_at":"2026-10-03T22:10:55Z","source_id":"fssa-official-package-20261003","source_identity":"in-fssa-27-88284-package-20261003","source_ref":"https://secure.in.gov/idoa/proc/solicitations/files/004980000088284.zip","source_sha256":"0bc2c4a47aa2cba6b5732b9308c6d581befd9df957dc03c22796349b5279b867","tags":["indiana-fssa","medicaid-administrative-claiming"],"text":"For proposed IT products or services, establish compatibility with applicable State IT policies and the assistive-technology standard, and address the RFP's ADA compliance requirement. Sensitive standards may require a contractor NDA."},{"family":"implementation_delivery","kind":"INFORMATIONAL","lineage_id":"FSSA-021-base-and-options","section_id":"RFP.1.13.p10","sequence":1,"source_captured_at":"2026-10-03T22:10:55Z","source_id":"fssa-official-package-20261003","source_identity":"in-fssa-27-88284-package-20261003","source_ref":"https://secure.in.gov/idoa/proc/solicitations/files/004980000088284.zip","source_sha256":"0bc2c4a47aa2cba6b5732b9308c6d581befd9df957dc03c22796349b5279b867","tags":["indiana-fssa","medicaid-administrative-claiming"],"text":"The base contract term is two years from execution, with two optional one-year extensions at the State's discretion."},{"family":"implementation_delivery","kind":"MANDATORY","lineage_id":"FSSA-022-mac-modernization","section_id":"AttF.1.2-1.5-and-AttK.Scope","sequence":1,"source_captured_at":"2026-10-03T22:10:55Z","source_id":"fssa-official-package-20261003","source_identity":"in-fssa-27-88284-package-20261003","source_ref":"https://secure.in.gov/idoa/proc/solicitations/files/004980000088284.zip","source_sha256":"0bc2c4a47aa2cba6b5732b9308c6d581befd9df957dc03c22796349b5279b867","tags":["indiana-fssa","medicaid-administrative-claiming"],"text":"Propose MAC framework modernization, redesigned and piloted time-study tools with FSSA and AAAs, standardized cost-reporting and cost-pooling processes, and support for AAA monitoring and quality improvement."},{"family":"implementation_delivery","kind":"MANDATORY","lineage_id":"FSSA-023-mac-operations","section_id":"AttF.1.6-1.8-and-AttK.Scope","sequence":1,"source_captured_at":"2026-10-03T22:10:55Z","source_id":"fssa-official-package-20261003","source_identity":"in-fssa-27-88284-package-20261003","source_ref":"https://secure.in.gov/idoa/proc/solicitations/files/004980000088284.zip","source_sha256":"0bc2c4a47aa2cba6b5732b9308c6d581befd9df957dc03c22796349b5279b867","tags":["indiana-fssa","medicaid-administrative-claiming"],"text":"Provide a plan for MAC claiming operations and error-free claim files during the base term and any extensions, stakeholder support, additional-agency onboarding when directed, and preparation for State operation."},{"family":"staffing","kind":"MANDATORY","lineage_id":"FSSA-024-project-plan-deliverables","section_id":"AttK.ProjectManagement","sequence":1,"source_captured_at":"2026-10-03T22:10:55Z","source_id":"fssa-official-package-20261003","source_identity":"in-fssa-27-88284-package-20261003","source_ref":"https://secure.in.gov/idoa/proc/solicitations/files/004980000088284.zip","source_sha256":"0bc2c4a47aa2cba6b5732b9308c6d581befd9df957dc03c22796349b5279b867","tags":["indiana-fssa","medicaid-administrative-claiming"],"text":"Provide a State-reviewable project plan with deadlines, staffing, communications and risks. Required outputs include activity catalog, time-study tool, training, cost-reporting guidance, operational reports, evaluation summaries, recommendations and transition materials."},{"family":"sla_support","kind":"MANDATORY","lineage_id":"FSSA-025-kpi-and-remedies","section_id":"AttK.KeyPerformanceIndicators","sequence":1,"source_captured_at":"2026-10-03T22:10:55Z","source_id":"fssa-official-package-20261003","source_identity":"in-fssa-27-88284-package-20261003","source_ref":"https://secure.in.gov/idoa/proc/solicitations/files/004980000088284.zip","source_sha256":"0bc2c4a47aa2cba6b5732b9308c6d581befd9df957dc03c22796349b5279b867","tags":["indiana-fssa","medicaid-administrative-claiming"],"text":"Plan for the stated minimum of 95% on-time submissions against the approved project plan and the quality, federal compliance, operational reliability, stakeholder-support and stewardship KPIs. Other details are finalized collaboratively; underperformance may lead to a corrective-action plan or payment delay."},{"family":"pricing_assumptions","kind":"MANDATORY","lineage_id":"FSSA-026-acceptance-and-ivv","section_id":"AttK.PaymentMilestones-and-IVV","sequence":1,"source_captured_at":"2026-10-03T22:10:55Z","source_id":"fssa-official-package-20261003","source_identity":"in-fssa-27-88284-package-20261003","source_ref":"https://secure.in.gov/idoa/proc/solicitations/files/004980000088284.zip","source_sha256":"0bc2c4a47aa2cba6b5732b9308c6d581befd9df957dc03c22796349b5279b867","tags":["indiana-fssa","medicaid-administrative-claiming"],"text":"Payments depend on deliverable acceptance. If the State employs IV&V, its approval precedes payment, and the contractor provides the IV&V team the required communications and access."},{"family":"implementation_delivery","kind":"MANDATORY","lineage_id":"FSSA-027-transition","section_id":"AttF.1.12-and-AttK.Transition","sequence":1,"source_captured_at":"2026-10-03T22:10:55Z","source_id":"fssa-official-package-20261003","source_identity":"in-fssa-27-88284-package-20261003","source_ref":"https://secure.in.gov/idoa/proc/solicitations/files/004980000088284.zip","source_sha256":"0bc2c4a47aa2cba6b5732b9308c6d581befd9df957dc03c22796349b5279b867","tags":["indiana-fssa","medicaid-administrative-claiming"],"text":"At the end of the base term or an extension, transfer the tools, artifacts and documentation, conduct knowledge transfer, support uninterrupted State operations, and deliver recommendations and a final transition/readiness report."},{"family":"ai_data_governance","kind":"MANDATORY","lineage_id":"FSSA-028-ai-disclosures","section_id":"AttL.AIQuestions","sequence":1,"source_captured_at":"2026-10-03T22:10:55Z","source_id":"fssa-official-package-20261003","source_identity":"in-fssa-27-88284-package-20261003","source_ref":"https://secure.in.gov/idoa/proc/solicitations/files/004980000088284.zip","source_sha256":"0bc2c4a47aa2cba6b5732b9308c6d581befd9df957dc03c22796349b5279b867","tags":["indiana-fssa","medicaid-administrative-claiming"],"text":"Answer separately for AI in the proposed solution and AI used by developers during implementation/support: use, disablement and consequences, control of functionality, and four-year introduction/expansion plans. The form also provides no-current-use/no-planned-use response paths."},{"family":"implementation_delivery","kind":"MANDATORY","lineage_id":"FSSA-029-hosting-applicability","section_id":"AttM.Introduction-and-SolutionCategories","sequence":1,"source_captured_at":"2026-10-03T22:10:55Z","source_id":"fssa-official-package-20261003","source_identity":"in-fssa-27-88284-package-20261003","source_ref":"https://secure.in.gov/idoa/proc/solicitations/files/004980000088284.zip","source_sha256":"0bc2c4a47aa2cba6b5732b9308c6d581befd9df957dc03c22796349b5279b867","tags":["indiana-fssa","medicaid-administrative-claiming"],"text":"State whether hosting is in scope. For hosting proposals, the State prefers a State-owned cloud tenant; justified alternatives may be considered. Cloud offerings must satisfy IOT Policy P.05 at implementation, and the form permits N/A for an unproposed hosting category."},{"family":"cybersecurity","kind":"MANDATORY","lineage_id":"FSSA-030-state-cloud-controls","section_id":"AttM.StateOwnedCloudTenant","sequence":1,"source_captured_at":"2026-10-03T22:10:55Z","source_id":"fssa-official-package-20261003","source_identity":"in-fssa-27-88284-package-20261003","source_ref":"https://secure.in.gov/idoa/proc/solicitations/files/004980000088284.zip","source_sha256":"0bc2c4a47aa2cba6b5732b9308c6d581befd9df957dc03c22796349b5279b867","tags":["indiana-fssa","medicaid-administrative-claiming"],"text":"If proposing a State-owned cloud tenant, address State ownership/control, residency of all solution data in that tenant, approved native monitoring/backup/recovery tools, access controls and encryption, audit/security reporting, and transition back to the State."},{"family":"cybersecurity","kind":"MANDATORY","lineage_id":"FSSA-031-external-cloud-exception","section_id":"AttM.VendorHostedCloudTenant","sequence":1,"source_captured_at":"2026-10-03T22:10:55Z","source_id":"fssa-official-package-20261003","source_identity":"in-fssa-27-88284-package-20261003","source_ref":"https://secure.in.gov/idoa/proc/solicitations/files/004980000088284.zip","source_sha256":"0bc2c4a47aa2cba6b5732b9308c6d581befd9df957dc03c22796349b5279b867","tags":["indiana-fssa","medicaid-administrative-claiming"],"text":"If proposing a vendor-owned cloud exception, justify why a State-owned tenant is infeasible and provide independently verified NIST 800-53 Revision 5 compliance, or a detailed path with independent verification, using the version current at go-live and the applicable cloud terms."},{"family":"cybersecurity","kind":"MANDATORY","lineage_id":"FSSA-032-continuity-and-data-security","section_id":"AttE.8.1-8.2","sequence":1,"source_captured_at":"2026-10-03T22:10:55Z","source_id":"fssa-official-package-20261003","source_identity":"in-fssa-27-88284-package-20261003","source_ref":"https://secure.in.gov/idoa/proc/solicitations/files/004980000088284.zip","source_sha256":"0bc2c4a47aa2cba6b5732b9308c6d581befd9df957dc03c22796349b5279b867","tags":["indiana-fssa","medicaid-administrative-claiming"],"text":"Report whether the company has a business-continuity/disaster-recovery plan and attach it if present; otherwise explain its alternative. Describe how State information maintained by the company is secured."},{"family":"pricing_assumptions","kind":"MANDATORY","lineage_id":"FSSA-033-cost-format-and-narratives","section_id":"RFP.2.5.p15-16","sequence":1,"source_captured_at":"2026-10-03T22:10:55Z","source_id":"fssa-official-package-20261003","source_identity":"in-fssa-27-88284-package-20261003","source_ref":"https://secure.in.gov/idoa/proc/solicitations/files/004980000088284.zip","source_sha256":"0bc2c4a47aa2cba6b5732b9308c6d581befd9df957dc03c22796349b5279b867","tags":["indiana-fssa","medicaid-administrative-claiming"],"text":"Use Attachment D in its original format, with a PDF cost narrative of no more than two pages for each item and a separate assumptions/conditions/constraints PDF. Costs must correspond to the technical response; conflicting assumptions or caveats are not acceptable."},{"family":"pricing_assumptions","kind":"MANDATORY","lineage_id":"FSSA-034-price-validity","section_id":"RFP.2.5.Pricing.p16","sequence":1,"source_captured_at":"2026-10-03T22:10:55Z","source_id":"fssa-official-package-20261003","source_identity":"in-fssa-27-88284-package-20261003","source_ref":"https://secure.in.gov/idoa/proc/solicitations/files/004980000088284.zip","source_sha256":"0bc2c4a47aa2cba6b5732b9308c6d581befd9df957dc03c22796349b5279b867","tags":["indiana-fssa","medicaid-administrative-claiming"],"text":"Proposed pricing must be firm and remain open for at least 180 days from award issuance."},{"family":"compliance_crosswalk","kind":"MANDATORY","lineage_id":"FSSA-035-confidential-response","section_id":"RFP.1.14-and-AttJ.5.0","sequence":1,"source_captured_at":"2026-10-03T22:10:55Z","source_id":"fssa-official-package-20261003","source_identity":"in-fssa-27-88284-package-20261003","source_ref":"https://secure.in.gov/idoa/proc/solicitations/files/004980000088284.zip","source_sha256":"0bc2c4a47aa2cba6b5732b9308c6d581befd9df957dc03c22796349b5279b867","tags":["indiana-fssa","medicaid-administrative-claiming"],"text":"If claiming confidential treatment, identify the specific APRA exception, affected document/section and rationale in Attachment J and provide the applicable separate redacted/confidential version. A blanket section label is insufficient."},{"family":"compliance_crosswalk","kind":"INFORMATIONAL","lineage_id":"FSSA-036-questions-and-written-authority","section_id":"RFP.1.6-and-1.23.p8-14","sequence":1,"source_captured_at":"2026-10-03T22:10:55Z","source_id":"fssa-official-package-20261003","source_identity":"in-fssa-27-88284-package-20261003","source_ref":"https://secure.in.gov/idoa/proc/solicitations/files/004980000088284.zip","source_sha256":"0bc2c4a47aa2cba6b5732b9308c6d581befd9df957dc03c22796349b5279b867","tags":["indiana-fssa","medicaid-administrative-claiming"],"text":"Written questions are due October 7, 2026 at 3:00 PM Eastern Time; responses/amendments are scheduled for October 14. Only posted written answers and addenda are binding."},{"family":"compliance_crosswalk","kind":"INFORMATIONAL","lineage_id":"FSSA-037-evaluation","section_id":"RFP.3.2.p17-20","sequence":1,"source_captured_at":"2026-10-03T22:10:55Z","source_id":"fssa-official-package-20261003","source_identity":"in-fssa-27-88284-package-20261003","source_ref":"https://secure.in.gov/idoa/proc/solicitations/files/004980000088284.zip","source_sha256":"0bc2c4a47aa2cba6b5732b9308c6d581befd9df957dc03c22796349b5279b867","tags":["indiana-fssa","medicaid-administrative-claiming"],"text":"Evaluation first checks mandatory requirements, then management/quality (50 points) and cost (30), with Buy Indiana (5), IVOSB (5) and a possible additional IVOSB point as specified."}],"schema":"procurement-solicitation-ingest/active-set/v1","truth_boundary":"INTERNAL_OWNER_REVIEW_ONLY"}
