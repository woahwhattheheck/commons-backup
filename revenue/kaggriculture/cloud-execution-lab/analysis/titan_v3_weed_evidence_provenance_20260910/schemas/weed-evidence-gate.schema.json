{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:titan:schema:weed-evidence-gate:v1",
  "title": "TITAN weed evidence gate decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "claim_id",
    "receipt_id",
    "decision",
    "reason_codes"
  ],
  "properties": {
    "schema_version": {
      "const": "titan.weed-evidence-gate.v1"
    },
    "claim_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "receipt_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "decision": {
      "enum": [
        "ACCEPT",
        "QUARANTINE",
        "INVALID"
      ]
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
