{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://woahwhattheheck.github.io/commons/schemas/titan/w10/realized-fertilizer-matrix-v1.schema.json",
  "title": "TITAN W10 realized fertilizer matrix manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "pairs"],
  "properties": {
    "schema": {"const": "titan.w10.realized-fertilizer-matrix/v1"},
    "pairs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {"$ref": "#/$defs/pair"}
    }
  },
  "$defs": {
    "pair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "control", "fertilized"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"},
        "control": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "fertilized": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}
      }
    }
  },
  "$comment": "matrix_runner.py additionally enforces unique pair IDs, unique control/treatment paths, distinct comparison identities, root confinement after symlink resolution, maximum trace byte size, and all-pairs certification."
}
