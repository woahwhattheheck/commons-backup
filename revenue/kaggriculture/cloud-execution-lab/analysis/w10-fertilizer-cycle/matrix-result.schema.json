{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://woahwhattheheck.github.io/commons/schemas/titan/w10/realized-fertilizer-matrix-result-v1.schema.json",
  "title": "TITAN W10 realized fertilizer matrix result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "decision", "reasons", "manifest_sha256", "pair_count", "certified_count", "rejected_count", "pairs", "result_sha256"],
  "properties": {
    "schema": {"const": "titan.w10.realized-fertilizer-matrix-result/v1"},
    "decision": {"enum": ["ADMIT", "REJECT"]},
    "reasons": {"type": "array", "items": {"type": "string"}},
    "manifest_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "pair_count": {"type": "integer", "minimum": 0},
    "certified_count": {"type": "integer", "minimum": 0},
    "rejected_count": {"type": "integer", "minimum": 0},
    "pairs": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/pair_result"}},
    "result_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "file_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "file_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      }
    },
    "pair_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "decision", "reasons", "control", "fertilized", "identity_sha256", "certificate_sha256"],
      "properties": {
        "id": {"type": "string"},
        "decision": {"enum": ["CERTIFIED", "REJECTED"]},
        "reasons": {"type": "array", "items": {"type": "string"}},
        "control": {"$ref": "#/$defs/file_ref"},
        "fertilized": {"$ref": "#/$defs/file_ref"},
        "identity_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "certificate_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      }
    }
  },
  "$comment": "matrix_runner.py enforces pair_count == len(pairs), certified_count + rejected_count == pair_count, ADMIT iff rejected_count is zero, and deterministic result hashing."
}
