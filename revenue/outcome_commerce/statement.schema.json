{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://woahwhattheheck.github.io/commons/revenue/outcome_commerce/statement.schema.json",
  "title": "Outcome Commerce Quote or Statement",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "kind",
    "statement_id",
    "created_at",
    "currency",
    "gross_amount",
    "credits_applied",
    "net_amount",
    "economic_state",
    "payment_truth"
  ],
  "properties": {
    "schema_version": {"const": "outcome-commerce-statement/v1"},
    "kind": {"enum": ["COMMERCE_QUOTE", "COMMERCE_STATEMENT"]},
    "statement_id": {"$ref": "#/$defs/id"},
    "created_at": {"$ref": "#/$defs/timestamp"},
    "currency": {"type": "string", "pattern": "^[A-Z][A-Z0-9._-]{1,31}$"},
    "gross_amount": {"$ref": "#/$defs/money"},
    "credits_applied": {"$ref": "#/$defs/money"},
    "net_amount": {"$ref": "#/$defs/money"},
    "economic_state": {"enum": ["QUOTED", "CHARGEABLE"]},
    "payment_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorization", "settlement", "payout", "bank_available", "cash_claimed"],
      "properties": {
        "authorization": {"const": "UNMEASURED"},
        "settlement": {"const": "UNMEASURED"},
        "payout": {"const": "UNMEASURED"},
        "bank_available": {"const": "UNMEASURED"},
        "cash_claimed": {"const": false}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "minLength": 8, "maxLength": 80, "pattern": "^[A-Za-z0-9._-]+$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"},
    "money": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{2})$"}
  }
}
