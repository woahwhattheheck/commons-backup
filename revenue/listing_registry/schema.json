{
  "$id":"https://woahwhattheheck.github.io/commons/revenue/listing_registry/schema.json",
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "properties":{
    "counts":{
      "properties":{
        "collected_cash_usd":{
          "type":[
            "null",
            "number",
            "string"
          ]
        },
        "duplicate_postings":{
          "const":0
        },
        "external_live_listings":{
          "const":0
        },
        "submitted":{
          "const":0
        },
        "verified_buyers":{
          "const":0
        }
      },
      "required":[
        "external_live_listings",
        "submitted",
        "duplicate_postings",
        "verified_buyers",
        "collected_cash_usd"
      ],
      "type":"object"
    },
    "kind":{
      "const":"COMMONS_LISTING_REGISTRY"
    },
    "listings":{
      "items":{
        "properties":{
          "chargeability_state":{
            "enum":[
              "ACTIVE_CHARGEABLE",
              "INTAKE_FIRST_ON_COMMONS",
              "NOT_A_PRICED_SKU",
              "NOT_CHARGEABLE_ON_THIS_SURFACE"
            ]
          },
          "duplicate":{
            "const":false
          },
          "published_status":{
            "enum":[
              "NOT_PUBLISHED",
              "SURFACE_PUBLISHED",
              "OWNER_PLATFORM_UNCLAIMED"
            ]
          },
          "submission_status":{
            "enum":[
              "NOT_SUBMITTED",
              "SUBMIT_FORBIDDEN"
            ]
          },
          "submit_allowed":{
            "const":false
          },
          "submitted":{
            "const":false
          }
        },
        "required":[
          "id",
          "offer_id",
          "sku",
          "evidence_packet",
          "chargeability_state",
          "submission_status",
          "published_status",
          "account_status",
          "owner",
          "url",
          "last_verified",
          "next_action",
          "duplicate"
        ],
        "type":"object"
      },
      "type":"array"
    },
    "schema_version":{
      "const":"listing-registry/v1"
    }
  },
  "required":[
    "schema_version",
    "kind",
    "as_of",
    "counts",
    "listings",
    "honesty"
  ],
  "title":"Commons listing registry",
  "type":"object"
}
