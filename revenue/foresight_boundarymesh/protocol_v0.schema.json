{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/boundarymesh/protocol-v0.schema.json",
  "title": "BoundaryMesh Event v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "event_id", "operation_id", "event_type", "actor_id", "resource", "boundary", "precondition", "created_at", "prev_digest", "evidence_digest"],
  "properties": {
    "version": {"const": "boundarymesh.v0"},
    "event_id": {"type": "string", "minLength": 8},
    "operation_id": {"type": "string", "minLength": 3},
    "event_type": {"enum": ["CLAIM", "PROPOSE", "ATTEST", "APPROVE", "ACT_RECEIPT", "CHALLENGE", "RELEASE"]},
    "actor_id": {"type": "string", "minLength": 1},
    "resource": {"type": "string", "minLength": 1},
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_actions", "state_fence", "expires_at", "irreversibility", "human_control"],
      "properties": {
        "allowed_actions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "state_fence": {"type": "string", "minLength": 1},
        "expires_at": {"type": ["string", "null"]},
        "irreversibility": {"enum": ["REVERSIBLE", "COSTLY", "IRREVERSIBLE"]},
        "human_control": {"enum": ["DELEGATED", "REVIEW", "REQUIRED"]}
      }
    },
    "precondition": {"type": "string"},
    "created_at": {"type": "string"},
    "prev_digest": {"type": ["string", "null"]},
    "evidence_digest": {"type": "string", "minLength": 16}
  }
}
