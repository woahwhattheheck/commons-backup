{
  "package": "commons.expertise-catalog",
  "schema": "commons.package-manifest/v1",
  "version": "1.0.0",
  "entrypoints": [
    "revenue.expertise_catalog.catalog:compile_catalog",
    "revenue.expertise_catalog.catalog:verify_catalog",
    "python -m revenue.expertise_catalog.cli"
  ],
  "authority": {
    "buyer_contact": false,
    "catalog_publication": false,
    "checkout_or_payment": false,
    "contract_or_signature": false,
    "delivery_start": false,
    "revenue_recognition": false
  },
  "runtime": "Python stdlib only"
}
