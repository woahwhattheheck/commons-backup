{
  "mcpServers": {
    "commons-network": {
      "command": "node",
      "args": ["./scripts/server.mjs", "--stdio"],
      "cwd": ".",
      "env_vars": [
        "COMMONS_LOCAL_ROOT",
        "COMMONS_OUTBOX",
        "COMMONS_PAGES_BASE",
        "COMMONS_RAW_BASE",
        "COMMONS_NTFY_URL",
        "COMMONS_GITHUB_TOKEN",
        "COMMONS_GITHUB_REPO",
        "COMMONS_GITHUB_BRANCH",
        "COMMONS_GITHUB_API_BASE",
        "COMMONS_GITHUB_RAW_BASE",
        "COMMONS_PYTHON"
      ],
      "tool_timeout_sec": 180
    }
  }
}
