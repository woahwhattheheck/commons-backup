[Unit]
Description=Commons grok.com Slack loopback token handoff
Documentation=https://github.com/woahwhattheheck/commons/blob/main/integrations/grok_slack/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/commons
Environment=COMMONS_GROK_SLACK_STATE_DB=/var/lib/commons/grok_slack.sqlite3
Environment=COMMONS_GROK_SLACK_HEALTH_BIND=127.0.0.1:8788
Environment=COMMONS_GROK_SLACK_HANDOFF_BIND=127.0.0.1:8789
Environment=COMMONS_GROK_SLACK_VAULT=/var/lib/commons/grok_slack.vault
ExecStart=/usr/bin/python3 /opt/commons/integrations/grok_slack/handoff.py serve
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ReadWritePaths=/var/lib/commons

[Install]
WantedBy=default.target
