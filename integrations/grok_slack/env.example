# Copy to a gitignored file and inject via the host environment.
#   integrations/grok_slack/.env.local
#   systemd EnvironmentFile
#   container env_file
#
# Desktop/browser path: do not put values here. Open
# http://127.0.0.1:8789/ and paste once. Tokens go into a current-user
# encrypted vault (Windows DPAPI / POSIX user-bound), never plaintext disk.
# Gemini's loopback handoff stays on 127.0.0.1:8780 and is not used.
#
# Never commit values. Doctor and health report present/missing only.
# Process environment wins over this file and over the vault. Connector
# infrastructure, not a Commons admission gate.

SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Optional. Public unauthenticated GitHub Contents readback is the default.
# Set only to raise rate limits on the always-on host.
# GITHUB_TOKEN=

# Optional overrides.
# COMMONS_GROK_SLACK_STATE_DB=/var/lib/commons/grok_slack.sqlite3
# COMMONS_GROK_SLACK_HEALTH_BIND=127.0.0.1:8788
# COMMONS_GROK_SLACK_HANDOFF_BIND=127.0.0.1:8789
# COMMONS_GROK_SLACK_VAULT=/var/lib/commons/grok_slack.vault

# Optional. Absolute path to the real commons clone used for isolated-index
# p+wake_jobs materialize. Needed when the scheduled Windows process cwd is
# not the clone (Task Scheduler, pythonw, service account). Never a secret.
# COMMONS_GROK_SLACK_GIT_ROOT=
