{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://commons.invalid/schemas/revenue-underwriter-input-v1.json",
  "title": "Commons revenue underwriter input v1",
  "type": "object",
  "required": ["candidate_id", "canonical_url", "currency", "advertised_amount", "freshness_receipt", "payout_history"],
  "properties": {
    "candidate_id": {"type": "string", "minLength": 1},
    "canonical_url": {"type": "string", "format": "uri"},
    "currency": {"type": "string", "pattern": "^[A-Za-z]{3}$"},
    "advertised_amount": {"type": ["number", "string"]},
    "freshness_receipt": {
      "type": "object",
      "required": ["schema", "generated_at", "candidate", "canonical", "checks", "freshness_status", "receipt_sha256"],
      "properties": {
        "schema": {"const": "commons-funded-work-freshness/v1"},
        "generated_at": {"type": "string", "format": "date-time"},
        "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "payout_history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_url", "source_class", "observed_at", "currency", "paid_total", "award_count"],
        "properties": {
          "source_url": {"type": "string", "format": "uri"},
          "source_class": {"enum": ["canonical", "sponsor", "payment_ledger", "marketplace"]},
          "observed_at": {"type": "string", "format": "date-time"},
          "currency": {"type": "string"},
          "paid_total": {"type": ["number", "string"]},
          "award_count": {"type": "integer", "minimum": 0},
          "completed_count": {"type": "integer", "minimum": 0},
          "open_pool": {"type": ["number", "string"]}
        }
      }
    }
  }
}
