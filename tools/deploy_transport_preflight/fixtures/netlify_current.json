{
  "schema": "deploy-transport-capability-manifest.v1",
  "provider": "netlify",
  "actions": [
    {
      "name": "create-new-project",
      "kind": "CREATE_PROJECT",
      "source_binding": "none"
    },
    {
      "name": "deploy-site",
      "kind": "DEPLOY_EXISTING_PROJECT",
      "source_binding": "existing_project_binding"
    }
  ]
}
