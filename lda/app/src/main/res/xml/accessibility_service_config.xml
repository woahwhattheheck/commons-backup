<?xml version="1.0" encoding="utf-8"?>
<!--
  Privacy note: we do NOT passively monitor the screen. onAccessibilityEvent() is
  empty - the agent only reads the screen on demand (snapshotScreen / screenshot)
  INSIDE an active task. So we subscribe to the minimum event type instead of
  typeAllMask: Android no longer streams every keystroke/scroll/content change to
  this app while it sits idle. canRetrieveWindowContent / canTakeScreenshot stay on
  because the agent needs them to act during a task - but they're only used then.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagRetrieveInteractiveWindows|flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:canTakeScreenshot="true"
    android:canPerformGestures="true"
    android:canRequestFilterKeyEvents="true"
    android:notificationTimeout="100" />
