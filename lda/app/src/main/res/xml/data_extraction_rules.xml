<?xml version="1.0" encoding="utf-8"?>
<!--
    §3 DATA-AT-REST: exclude EVERY app file from both cloud backup and device-to-device transfer. The crown-jewel
    data-at-rest (the diverged .litertlm, the WeightGenome edit-journal, the pristine baseline + snapshot ring, and
    the learned memory) must never leave the device via a backup/transfer channel — with allowBackup=false this
    covers the legacy path, and these rules cover the Android-12+ cloud-backup + device-transfer paths so an
    adb backup / D2D migration can't pull the model files or the edit map. On-device only, by design.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
