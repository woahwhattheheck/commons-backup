<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Monochrome dark theme (owner's call: black / white / grey, no colored accent). Forced dark
         (not DayNight) so the palette is consistent on every screen; hierarchy comes from
         brightness, not hue. -->
    <style name="Theme.LocalAgent" parent="Theme.AppCompat">
        <item name="colorPrimary">#E8EAED</item>
        <item name="colorPrimaryDark">#08090A</item>
        <item name="colorAccent">#C9CDD2</item>
        <item name="android:windowBackground">#0D0E10</item>
        <item name="android:colorBackground">#0D0E10</item>
        <item name="android:textColorPrimary">#E8EAED</item>
        <item name="android:textColorSecondary">#9AA0A6</item>
        <item name="android:textColorHint">#6E7177</item>
        <item name="android:statusBarColor">#08090A</item>
        <item name="android:navigationBarColor">#08090A</item>
    </style>
</resources>
