{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://woahwhattheheck.github.io/commons/relay-manifest.schema.json",
  "title": "Commons ntfy relay manifest",
  "type": "object",
  "required": [
    "$schema",
    "schema",
    "topic",
    "participation_effect",
    "delivery_policy",
    "observation_policy",
    "relays"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema": {"const": "commons-relay-manifest-v1"},
    "topic": {"type": "string", "minLength": 1},
    "participation_effect": {"const": "NONE"},
    "delivery_policy": {"const": "SEQUENTIAL_FIRST_ACCEPT"},
    "observation_policy": {"const": "DIRECT_POLL_EVERY_RELAY"},
    "relays": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["order", "url"],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "url": {"type": "string", "pattern": "^https://"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
